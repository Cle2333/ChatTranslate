<Window x:Class="ChatTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatTranslate · P0 可行性自检"
        Height="760" Width="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="P0 可行性自检" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Foreground="#666"
                       Text="逐项验证：系统 OCR · 划词取词 · 全局热键 · Ollama 翻译 · 剪贴板保护" />
        </StackPanel>

        <!-- 环境信息 -->
        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="EnvText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"
                           Text="尚未检测环境。点击下方「检测环境」。" />
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnEnv" Content="检测环境" Width="110" Height="34" Margin="0,0,8,8"
                    Click="OnCheckEnvironment" />
            <Button x:Name="BtnGrab" Content="取词测试" Width="110" Height="34" Margin="0,0,8,8"
                    Click="OnGrabSelection" />
            <Button x:Name="BtnOcr" Content="OCR 测试" Width="110" Height="34" Margin="0,0,8,8"
                    Click="OnOcrTest" />
            <Button x:Name="BtnHotkey" Content="热键测试" Width="110" Height="34" Margin="0,0,8,8"
                    Click="OnHotkeyTest" />
            <Button x:Name="BtnTranslate" Content="翻译测试" Width="110" Height="34" Margin="0,0,8,8"
                    Click="OnTranslateTest" />
            <Button x:Name="BtnClipboard" Content="剪贴板保护测试" Width="140" Height="34" Margin="0,0,8,8"
                    Click="OnClipboardTest" />
            <Button x:Name="BtnClear" Content="清空日志" Width="100" Height="34" Margin="0,0,8,8"
                    Click="OnClearLog" />
        </WrapPanel>

        <!-- 日志 -->
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="12.5"
                     BorderThickness="0"
                     Padding="10"
                     Background="#FCFCFC" />
        </Border>
    </Grid>
</Window>
