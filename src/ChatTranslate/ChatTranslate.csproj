<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 关键：10.0.19041.0 后缀让 Windows.Media.Ocr 等 WinRT API 直接可用（同进程、零外部依赖） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ChatTranslate</AssemblyName>
    <RootNamespace>ChatTranslate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>0.1.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 应用图标：编译期嵌入 exe 的 Win32 图标资源，决定资源管理器 / 任务栏 / Alt+Tab 显示什么。
         多尺寸 ico（16~256）由 Assets/app.ico 提供，见同目录说明。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标资源：窗口的 Icon 与标题栏图标要从 pack URI 取，必须显式声明为 Resource
         （WindowsDesktop SDK 不会自动通配 Assets 下的图片）。 -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-32.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 会话存储：单文件数据库，支持增量读写与检索 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Fluent 2 / Windows 11 设计语言。纯托管包，不引入运行时依赖，单文件发布不受影响 -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
