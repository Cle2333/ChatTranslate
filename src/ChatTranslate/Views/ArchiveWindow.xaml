<ui:FluentWindow x:Class="ChatTranslate.Views.ArchiveWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="已归档的对话"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="700" Height="560"
                 MinWidth="560" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                 FontSize="13">

    <Window.Resources>
        <!-- 归档条目：标题 + 时间 + 消息数，右侧两个操作按钮 -->
        <DataTemplate x:Key="ArchivedItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="10.5"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="{Binding TimeText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding MessageCount, Mode=OneWay}" />
                        <Run Text=" 条消息" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button Padding="7,3"
                               Icon="{ui:SymbolIcon ArrowUndo24}"
                               ToolTip="恢复这个对话（回到侧边栏）"
                               AutomationProperties.Name="恢复"
                               Click="OnRestoreClick" />
                    <ui:Button Padding="7,3"
                               Margin="6,0,0,0"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="删除这个对话"
                               AutomationProperties.Name="删除"
                               Click="OnDeleteClick" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="已归档的对话"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 说明 -->
        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <TextBlock Text="归档的对话不会出现在侧边栏，但内容完整保留，可随时恢复。"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
            <TextBlock FontSize="11.5"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="恢复后对话回到侧边栏的原有位置；删除会一并清掉它的消息与截图文件，无法撤销。" />
        </StackPanel>

        <!-- 归档列表；为空时显示提示文案 -->
        <Grid Grid.Row="2">
            <ListBox x:Name="ArchivedList"
                     Margin="24,0"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource ArchivedItemTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="7"
                                            Padding="10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Text="暂无已归档的对话"
                       FontSize="12.5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="Collapsed" />
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CountHint"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <ui:Button Grid.Column="1"
                           Content="关闭"
                           Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
