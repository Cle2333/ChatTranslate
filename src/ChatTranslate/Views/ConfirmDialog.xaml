<ui:FluentWindow x:Class="ChatTranslate.Views.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="确认"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="460"
                 SizeToContent="Height"
                 MinHeight="0"
                 MinWidth="0"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                 FontSize="13">

    <!--
        也用 FluentWindow 而不是系统 MessageBox：
        原生 MessageBox 是浅色的系统模板，在深色界面里会弹出一块白底，
        与整个应用的风格完全脱节（实测截图确认）。

        不用 ui:ContentDialog：那套要配 ContentDialogHost / 服务注册，
        为一个确认框不值当。这里就是个小窗口，ShowDialog 返回 bool 即可。

        ★ MinHeight / MinWidth 必须显式归零：FluentWindow 的静态构造会覆盖默认属性，
        自带一个 320 DIP 的 MinHeight。窗口被它顶住后，内容再矮也缩不掉，
        底部就多出一截空白（实测：窗口 320 DIP / 内容 222.7 DIP）。
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     Title="确认"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,6,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 图标用语义色，一眼看出是警告还是普通提示 -->
            <ui:SymbolIcon x:Name="DialogIcon"
                           Grid.Column="0"
                           Symbol="Warning24"
                           FontSize="26"
                           Margin="0,2,14,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadlineText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText"
                           Margin="0,8,0,0"
                           FontSize="12.5"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!--
                    取消是默认按钮：回车走「取消」，删除这类操作不该被一个回车确认掉。
                    IsCancel 让 Esc 也能取消。
                -->
                <ui:Button x:Name="CancelButton"
                           Content="取消"
                           IsDefault="True"
                           IsCancel="True"
                           MinWidth="88"
                           Margin="0,0,10,0"
                           Click="OnCancelClick" />
                <ui:Button x:Name="ConfirmButton"
                           MinWidth="88"
                           Click="OnConfirmClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
