<ui:FluentWindow x:Class="ChatTranslate.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Height="700" Width="580"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                 FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="设置" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ 语言 ═══ -->
                <TextBlock Text="语言" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,10" />

                <TextBlock Text="输入语言" FontSize="12.5" Margin="0,0,0,5" />
                <ComboBox x:Name="SourceLanguageBox" Margin="0,0,0,14" />

                <TextBlock Text="目标语言" FontSize="12.5" Margin="0,0,0,5" />
                <ComboBox x:Name="LanguageBox" Margin="0,0,0,6" />
                <TextBlock Text="与主界面输入框上方的语言选框是同一份设置，两处同步。"
                           FontSize="11.5"
                           Margin="0,0,0,18"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBlock Text="下拉里显示哪些语种" FontSize="12.5" Margin="0,0,0,6" />

                <!--
                    语种平铺曾在设置页里直接铺开，但语种有 37 个，会占掉大半个页面，
                    把服务/快捷键/划词都挤到下面。改为一行摘要 + 一个按钮，点开独立窗口挑选。
                -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LanguageSummary"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <ui:Button x:Name="PickLanguagesButton"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               Padding="10,3"
                               Content="选择…"
                               Icon="{ui:SymbolIcon LocalLanguage24}"
                               ToolTip="打开窗口挑选要显示在下拉里的语种"
                               Click="OnPickLanguagesClick" />
                </Grid>
                <TextBlock Text="中文与英语始终显示；当前正在使用的语言也会自动保留。此处只挑选，点「保存」后才写入配置。"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,3,0,18"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <Separator Margin="0,0,0,16" />

                <!-- ═══ 服务 ═══ -->
                <TextBlock Text="服务" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

                <TextBlock Text="Ollama 地址" FontSize="12.5" Margin="0,0,0,5" />
                <ui:TextBox x:Name="HostBox" PlaceholderText="http://127.0.0.1:11434" Margin="0,0,0,14" />

                <TextBlock Text="模型" FontSize="12.5" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--
                        可编辑下拉：既能从已安装模型里挑（免得手打错名字），
                        也能直接输入（例如刚 ollama create 出来、还没来得及刷新）。
                        与主界面输入框上方的「模型」是同一个配置项。
                    -->
                    <ComboBox x:Name="ModelBox"
                              Grid.Column="0"
                              IsEditable="True"
                              ToolTip="可从下拉选择已安装的模型，也可直接输入模型名" />
                    <ui:Button x:Name="RefreshModelsButton"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               Padding="8,3"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="从 Ollama 重新获取已安装的模型"
                               Click="OnRefreshModelsClick" />
                </Grid>
                <TextBlock x:Name="ModelListHint"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="下拉里列出 Ollama 已安装的模型；也可以直接输入名字。" />

                <TextBlock Text="上下文窗口 (num_ctx)" FontSize="12.5" Margin="0,0,0,5" />
                <ui:TextBox x:Name="NumCtxBox" PlaceholderText="8192" Margin="0,0,0,14" />

                <TextBlock Text="模型保留时长 (keep_alive)" FontSize="12.5" Margin="0,0,0,5" />
                <ui:TextBox x:Name="KeepAliveBox" PlaceholderText="30m" Margin="0,0,0,4" />
                <TextBlock Text="模型在显存里的保留时长，如 30m / 2h，也可以写秒数 600；填 -1 表示常驻不卸载。Ollama 默认只留 5 分钟，被卸载后下一次翻译要先等它重新载入（约 7 秒）。"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0,0,0,20" />

                <Separator Margin="0,0,0,16" />

                <!-- ═══ 快捷键 ═══ -->
                <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                <TextBlock Text="形如 Ctrl+Alt+O；留空表示不注册。修改后需要重启程序生效。"
                           FontSize="11.5"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBlock Text="截图 OCR 翻译" FontSize="12.5" Margin="0,0,0,5" />
                <ui:TextBox x:Name="HotkeyOcrBox" PlaceholderText="Ctrl+Alt+O" Margin="0,0,0,14" />

                <TextBlock Text="呼出主窗口" FontSize="12.5" Margin="0,0,0,5" />
                <ui:TextBox x:Name="HotkeyWindowBox" PlaceholderText="Ctrl+Alt+T" Margin="0,0,0,20" />

                <Separator Margin="0,0,0,16" />

                <!-- ═══ 划词 ═══ -->
                <TextBlock Text="划词翻译" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

                <TextBlock Text="防抖延迟（毫秒）" FontSize="12.5" Margin="0,0,0,5" />
                <ui:TextBox x:Name="DelayBox" PlaceholderText="350" Margin="0,0,0,14" />

                <TextBlock Text="排除的应用（每行一个进程名，不含 .exe）" FontSize="12.5" Margin="0,0,0,5" />
                <ui:TextBox x:Name="BlacklistBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Height="104"
                            VerticalScrollBarVisibility="Auto"
                            PlaceholderText="WindowsTerminal&#x0a;KeePassXC"
                            Margin="0,0,0,4" />
                <TextBlock Text="在这些应用里划词不会触发翻译。终端里选中的多是命令，密码管理器里则是敏感信息。"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0,0,0,14" />

                <ui:ToggleSwitch x:Name="DiagnosticToggle"
                                 Content="记录诊断日志"
                                 Margin="0,0,0,4" />
                <TextBlock Text="划词没反应时打开它，然后查看数据目录下 logs\ 里的日志——能看到钩子是否装上、取词是否取到、被哪条规则拦下。平时关闭以免日志膨胀。"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0,0,0,20" />

                <Separator Margin="0,0,0,16" />

                <!-- ═══ 数据位置 ═══ -->
                <TextBlock Text="数据位置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <ui:TextBox x:Name="DataPathBox"
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            Margin="0,0,0,6" />
                <TextBlock Text="配置、会话记录与截图都存在这里，程序目录不写任何文件。"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消" Margin="0,0,10,0" Click="OnCancel" />
                <ui:Button Content="保存" Appearance="Primary" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
