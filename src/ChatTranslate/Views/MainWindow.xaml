<ui:FluentWindow x:Class="ChatTranslate.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:ChatTranslate.Views"
                 Title="ChatTranslate"
                 Height="820" Width="1240"
                 MinHeight="600" MinWidth="960"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                 FontSize="13">

    <Window.Resources>
        <local:PathToImageConverter x:Key="PathToImage" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisible" />

        <!-- 侧边栏历史条目：无来源徽标，只有标题与时间 -->
        <DataTemplate x:Key="ThreadItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12.5" />
                <TextBlock Grid.Row="1"
                           Text="{Binding TimeText}"
                           FontSize="10.5"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- 气泡：纯文本 -->
        <DataTemplate x:Key="BubbleTextTemplate">
            <Grid Margin="0,0,0,14">
                <Border MaxWidth="660" CornerRadius="12" Padding="14,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Background"
                                    Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Background" Value="#FF0A84F4" />
                                    <Setter Property="BorderBrush" Value="#FF0A84F4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="10.5"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Opacity="0.55" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 气泡：截图 OCR —— 用户侧直接显示截图本身 -->
        <DataTemplate x:Key="BubbleImageTemplate">
            <Grid Margin="0,0,0,14" HorizontalAlignment="Right">
                <Border MaxWidth="480"
                        CornerRadius="12"
                        Padding="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Border CornerRadius="8" ClipToBounds="True">
                            <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"
                                   MaxHeight="360"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="10.5"
                                   Margin="4,6,4,2"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:BubbleTemplateSelector x:Key="BubbleSelector"
                                      TextTemplate="{StaticResource BubbleTextTemplate}"
                                      ImageTemplate="{StaticResource BubbleImageTemplate}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ChatTranslate" />

        <!-- ═══════════ 主体 ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─────────── 侧边栏 ─────────── -->
            <Border Grid.Column="0"
                    Background="#0AFFFFFF"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,4,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 翻译历史 -->
                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Text="翻译历史"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:Button HorizontalAlignment="Right"
                                   Padding="6,3"
                                   Icon="{ui:SymbolIcon Add24}"
                                   ToolTip="新对话"
                                   Click="OnNewThreadClick" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             x:Name="ThreadList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource ThreadItemTemplate}"
                             SelectionChanged="OnThreadSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="7"
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#220A84F4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 划词翻译开关（位于设置按钮上方） -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,10,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="划词翻译"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ui:ToggleSwitch x:Name="SelectionToggle"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="OnSelectionToggled"
                                             Unchecked="OnSelectionToggled" />
                        </Grid>
                    </Border>

                    <!-- 设置 -->
                    <ui:Button Grid.Row="3"
                               x:Name="SettingsButton"
                               Content="设置"
                               Icon="{ui:SymbolIcon Settings24}"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Click="OnSettingsClick" />
                </Grid>
            </Border>

            <!-- ─────────── 主区 ─────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ChatScroll"
                              Grid.Row="0"
                              Padding="30,14,30,16"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessageList"
                                  ItemTemplateSelector="{StaticResource BubbleSelector}" />
                </ScrollViewer>

                <!-- 语言选择 + 输入框 -->
                <StackPanel Grid.Row="1" Margin="30,0,30,14">

                    <!-- 语言选框（在输入框上方） -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,7">
                        <TextBlock Text="输入语言"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="SourceLangBox"
                                  Width="132"
                                  SelectionChanged="OnLanguageChanged" />

                        <TextBlock Text="→"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <TextBlock Text="目标语言"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="TargetLangBox"
                                  Width="132"
                                  SelectionChanged="OnLanguageChanged" />

                        <ui:Button x:Name="SwapLangButton"
                                   Margin="8,0,0,0"
                                   Padding="7,3"
                                   Icon="{ui:SymbolIcon ArrowSwap24}"
                                   ToolTip="互换输入与目标语言"
                                   Click="OnSwapLanguagesClick" />

                        <TextBlock x:Name="LangHint"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="#FFB300"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!-- 输入框 -->
                    <Border CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0"
                                       x:Name="OcrButton"
                                       Margin="8,8,2,8"
                                       Padding="10,7"
                                       Icon="{ui:SymbolIcon Cut24}"
                                       ToolTip="截图 OCR 翻译"
                                       Click="OnOcrClick" />

                            <ui:TextBox x:Name="InputBox"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        PlaceholderText="输入要翻译的文字，回车发送…"
                                        MinHeight="42"
                                        MaxHeight="120"
                                        AcceptsReturn="False"
                                        TextWrapping="Wrap"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        VerticalContentAlignment="Center"
                                        KeyDown="OnInputKeyDown" />

                            <ui:Button Grid.Column="2"
                                       x:Name="SendButton"
                                       Margin="2,8,8,8"
                                       Padding="12,7"
                                       Icon="{ui:SymbolIcon Send24}"
                                       ToolTip="发送 (Enter)"
                                       Click="OnSendClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════════ 状态栏（信息右对齐）═══════════ -->
        <Border Grid.Row="2"
                Background="#0AFFFFFF"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusTarget"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="#33FFFFFF" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusVersion"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="#33FFFFFF" VerticalAlignment="Center" />

                <Ellipse x:Name="StatusDot"
                         Width="7" Height="7"
                         Fill="#FF9E9E9E"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0" />
                <TextBlock x:Name="StatusOllama"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="#33FFFFFF" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusSpeed"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="#33FFFFFF" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusContext"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
