<ui:FluentWindow x:Class="ChatTranslate.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:ChatTranslate.Views"
                 Title="ChatTranslate"
                 Height="820" Width="1240"
                 MinHeight="600" MinWidth="960"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                 FontSize="13">

    <Window.Resources>
        <local:PathToImageConverter x:Key="PathToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- 侧边栏历史条目：无来源徽标，只有标题与时间 -->
        <DataTemplate x:Key="ThreadItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12.5" />
                <TextBlock Grid.Row="1"
                           Text="{Binding TimeText}"
                           FontSize="10.5"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- 气泡：纯文本 -->
        <DataTemplate x:Key="BubbleTextTemplate">
            <Grid Margin="0,0,0,14">
                <Border MaxWidth="660" CornerRadius="12" Padding="14,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Background"
                                    Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!--
                        气泡内的文字颜色必须跟着气泡底色走。
                        用户气泡用强调色填充，文字就得用"强调色上的文字"这一主题笔刷；
                        若沿用主题默认前景色，切到浅色主题时会出现深字压深蓝底。
                    -->
                    <Border.Resources>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>

                    <StackPanel>
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,6,0,0">
                            <!-- 流式生成中的指示，避免用户以为程序卡住。
                                 文案由 StreamingLabel 驱动：模型需要先载入显存时换成
                                 「模型加载中…」，否则用户看到的是一动不动的「生成中」。 -->
                            <TextBlock Text="{Binding StreamingLabel}"
                                       FontSize="10.5"
                                       Margin="0,0,6,0"
                                       Opacity="0.55"
                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="{Binding TimeText}"
                                       FontSize="10.5"
                                       Opacity="0.55" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 气泡：截图 OCR —— 用户侧直接显示截图本身 -->
        <DataTemplate x:Key="BubbleImageTemplate">
            <Grid Margin="0,0,0,14" HorizontalAlignment="Right">
                <Border MaxWidth="480"
                        CornerRadius="12"
                        Padding="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Border CornerRadius="8" ClipToBounds="True">
                            <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"
                                   MaxHeight="360"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="10.5"
                                   Margin="4,6,4,2"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:BubbleTemplateSelector x:Key="BubbleSelector"
                                      TextTemplate="{StaticResource BubbleTextTemplate}"
                                      ImageTemplate="{StaticResource BubbleImageTemplate}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ChatTranslate" />

        <!-- ═══════════ 主体 ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─────────── 侧边栏 ─────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,4,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 翻译历史 -->
                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Text="翻译历史"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:Button HorizontalAlignment="Right"
                                   Padding="6,3"
                                   Icon="{ui:SymbolIcon Add24}"
                                   ToolTip="新对话"
                                   Click="OnNewThreadClick" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             x:Name="ThreadList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource ThreadItemTemplate}"
                             SelectionChanged="OnThreadSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="7"
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 划词翻译开关（位于设置按钮上方） -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,10,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="划词翻译"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ui:ToggleSwitch x:Name="SelectionToggle"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="OnSelectionToggled"
                                             Unchecked="OnSelectionToggled" />
                        </Grid>
                    </Border>

                    <!-- 设置 -->
                    <ui:Button Grid.Row="3"
                               x:Name="SettingsButton"
                               Content="设置"
                               Icon="{ui:SymbolIcon Settings24}"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Click="OnSettingsClick" />
                </Grid>
            </Border>

            <!-- ─────────── 主区 ─────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ScrollViewer x:Name="ChatScroll"
                                  Padding="30,14,30,16"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MessageList"
                                      ItemTemplateSelector="{StaticResource BubbleSelector}" />
                    </ScrollViewer>

                    <!--
                        空会话的欢迎词。新对话没有任何消息时显示，
                        一旦有消息就隐藏（由 _messages 的集合变更驱动）。
                        IsHitTestVisible=False：纯展示，不拦截鼠标事件。
                    -->
                    <StackPanel x:Name="WelcomePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <TextBlock x:Name="WelcomeGreeting"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="WelcomeHint"
                                   FontSize="15"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 语言选择 + 输入框 -->
                <StackPanel Grid.Row="1" Margin="30,0,30,14">

                    <!-- 语言选框（在输入框上方） -->
                    <!--
                        语言 + 模型选框（在输入框上方）。
                        用 WrapPanel 而不是 StackPanel：这一行内容宽度接近窗口最小宽度
                        （960 时约 660 DIP，可用宽度 628 DIP），固定单行会被窗口裁掉右侧控件。
                        WrapPanel 在放不下时把后面的项换到下一行，任何窗口宽度下都不会丢控件。
                    -->
                    <WrapPanel Margin="2,0,0,7">
                        <TextBlock Text="输入语言"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="SourceLangBox"
                                  Width="132"
                                  SelectionChanged="OnLanguageChanged" />

                        <TextBlock Text="→"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <TextBlock Text="目标语言"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="TargetLangBox"
                                  Width="132"
                                  SelectionChanged="OnLanguageChanged" />

                        <ui:Button x:Name="SwapLangButton"
                                   Margin="8,0,0,0"
                                   Padding="7,3"
                                   Icon="{ui:SymbolIcon ArrowSwap24}"
                                   ToolTip="互换输入与目标语言"
                                   Click="OnSwapLanguagesClick" />

                        <!--
                            本地模型切换。放在语言选择右侧，与设置页的「模型」同一个配置项，
                            两处同步（改任一处，另一处随后刷新）。
                            内容来自 Ollama 的 /api/tags；展开下拉时才去拉，不随启动阻塞界面。
                        -->
                        <TextBlock Text="模型"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="18,0,7,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="ModelBox"
                                  Width="150"
                                  ToolTip="本地 Ollama 使用的模型"
                                  SelectionChanged="OnModelChanged"
                                  DropDownOpened="OnModelDropDownOpened" />

                        <TextBlock x:Name="LangHint"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="Collapsed" />
                    </WrapPanel>

                    <!-- 输入框 -->
                    <Border CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0"
                                       x:Name="OcrButton"
                                       Margin="8,8,2,8"
                                       Padding="10,7"
                                       Icon="{ui:SymbolIcon Cut24}"
                                       ToolTip="截图 OCR 翻译"
                                       Click="OnOcrClick" />

                            <!--
                                输入框。
                                高度按行数给（不是写死 120 DIP）：译文工具经常要粘整段文字，
                                原来 4~5 行就到顶，多出来的内容看不见，用起来像"有字数上限"。
                                VerticalScrollBarVisibility=Auto：内容超出时给出明确的滚动条，
                                否则用户无法判断"是到顶了还是没边"。
                            -->
                            <ui:TextBox x:Name="InputBox"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        PlaceholderText="输入要翻译的文字，回车发送…"
                                        MinHeight="42"
                                        MaxHeight="240"
                                        AcceptsReturn="False"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        VerticalContentAlignment="Center"
                                        TextChanged="OnInputTextChanged"
                                        KeyDown="OnInputKeyDown" />

                            <ui:Button Grid.Column="2"
                                       x:Name="SendButton"
                                       Margin="2,8,8,8"
                                       Padding="12,7"
                                       Icon="{ui:SymbolIcon Send24}"
                                       ToolTip="发送 (Enter)"
                                       Click="OnSendClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════════ 状态栏（信息右对齐）═══════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusTarget"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusVersion"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                <Ellipse x:Name="StatusDot"
                         Width="7" Height="7"
                         Fill="{DynamicResource SystemFillColorNeutralBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0" />
                <TextBlock x:Name="StatusOllama"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusSpeed"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusContext"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                <!-- 输入字数：让"输入框到底能装多少"变得可见，不用猜 -->
                <TextBlock x:Name="StatusInputCount"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
