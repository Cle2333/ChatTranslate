<ui:FluentWindow x:Class="WpfUiSpike.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ChatTranslate"
                 Height="780" Width="1180"
                 MinHeight="560" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                 FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 标题栏 ═══ -->
        <ui:TitleBar Grid.Row="0" Title="ChatTranslate" />

        <!-- ═══ 主体：侧边栏 + 主区 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="276" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── 侧边栏 ─── -->
            <Border Grid.Column="0"
                    Background="#0AFFFFFF"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,6,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 划词翻译开关 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="划词翻译" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock x:Name="SelectionHint"
                                           Text="选中即翻译"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="SelectionToggle"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="True"
                                             Checked="OnSelectionToggled"
                                             Unchecked="OnSelectionToggled" />
                        </Grid>
                    </Border>

                    <!-- 翻译历史 -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <TextBlock Text="翻译历史"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button HorizontalAlignment="Right"
                                       Padding="6,3"
                                       Icon="{ui:SymbolIcon Add24}"
                                       ToolTip="新对话"
                                       Click="OnNewChatClick" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="HistoryList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,3" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        CornerRadius="7"
                                                        Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#220A84F4" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12.5" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Source}"
                                                       FontSize="10.5"
                                                       Padding="5,1"
                                                       Foreground="#8AB4F8"
                                                       Background="#1A0A84F4"
                                                       />
                                            <TextBlock Text="{Binding Time}"
                                                       FontSize="10.5"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 设置 -->
                    <ui:Button Grid.Row="2"
                               x:Name="SettingsButton"
                               Content="设置"
                               Icon="{ui:SymbolIcon Settings24}"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,10,0,0"
                               Click="OnSettingsClick" />
                </Grid>
            </Border>

            <!-- ─── 主区 ─── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 对话区 -->
                <ScrollViewer x:Name="ChatScroll"
                              Grid.Row="0"
                              Padding="30,10,30,16"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Border MaxWidth="640"
                                            CornerRadius="12"
                                            Padding="14,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                <Setter Property="Background"
                                                        Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Setter Property="Background" Value="#FF0A84F4" />
                                                        <Setter Property="BorderBrush" Value="#FF0A84F4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="22" />
                                            <TextBlock Text="{Binding Time}"
                                                       FontSize="10.5"
                                                       Margin="0,6,0,0"
                                                       HorizontalAlignment="Right"
                                                       Opacity="0.55" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区 -->
                <Border Grid.Row="1"
                        Margin="30,0,30,14"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="InputBox"
                                    Grid.Column="0"
                                    PlaceholderText="输入要翻译的文字，回车发送…"
                                    MinHeight="42"
                                    MaxHeight="120"
                                    AcceptsReturn="False"
                                    TextWrapping="Wrap"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalContentAlignment="Center"
                                    KeyDown="OnInputKeyDown" />

                        <ui:Button Grid.Column="1"
                                   Margin="8"
                                   Padding="12,7"
                                   Icon="{ui:SymbolIcon Send24}"
                                   ToolTip="发送 (Enter)"
                                   Click="OnSendClick" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ 状态栏 ═══ -->
        <Border Grid.Row="2"
                Background="#0AFFFFFF"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="v0.1.0"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="#33FFFFFF" VerticalAlignment="Center" />

                <Ellipse Width="7" Height="7" Fill="#FF4CAF50" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Ollama 已连接 · hy-mt2:7b-q4km"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="#33FFFFFF" VerticalAlignment="Center" />

                <TextBlock Text="48.7 tok/s"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Rectangle Width="1" Height="12" Margin="12,0" Fill="#33FFFFFF" VerticalAlignment="Center" />

                <TextBlock Text="上下文 29 / 8192"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
